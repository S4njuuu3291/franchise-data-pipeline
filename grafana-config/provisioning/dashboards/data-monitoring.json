          "rawQuery": true,
          "rawSql": "WITH asset_daily_volume AS (\n    SELECT\n        execution_date,\n        stage,\n        asset_name,\n        MAX(volume) AS volume\n    FROM data_quality_ledger\n    GROUP BY execution_date, stage, asset_name\n)\nSELECT\n    execution_date::timestamp AS time,\n    stage AS metric, -- Kolom ini yang otomatis bikin garisnya terpisah (Bronze, Silver, Gold, dll)\n    SUM(volume) AS value\nFROM asset_daily_volume\nGROUP BY execution_date, stage\nORDER BY execution_date;\n",
          "refId": "A",
